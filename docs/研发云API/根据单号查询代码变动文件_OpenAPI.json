          "type": "string"
        }
      }
    },
    "ApiTaskBranchChangeFileRespDto": {
      "type": "object",
      "description": "特性分支对应的代码仓库基本信息",
      "properties": {
        "repoId": {
          "type": "integer",
          "format": "int64",
          "description": "仓库标志",
          "refType": null
        },
        "ownerName": {
          "type": "string",
          "description": "仓库Owner名称",
          "refType": null
        },
        "repoName": {
          "type": "string",
          "description": "仓库名称",
          "refType": null
        },
        "repoUrl": {
          "type": "string",
          "description": "仓库地址",
          "refType": null
        },
        "changeFileDtoList": {
          "type": "array",
          "description": "仓库变动文件列表",
          "items": {
            "$ref": "#/components/schemas/ApiTaskBranchChangeFileDto"
          },
          "refType": "ApiTaskBranchChangeFileDto"
        }
      }
    },
    "ApiTaskBranchChangeFileDto": {
      "type": "object",
      "description": "任务单变动文件列表",
      "properties": {
        "operType": {
          "type": "string",
