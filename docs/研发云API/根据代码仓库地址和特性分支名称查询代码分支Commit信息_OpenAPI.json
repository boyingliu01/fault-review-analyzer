        "branchName": {
          "type": "string",
          "description": "特性分支名称",
          "refType": null
        },
        "baseBranchName": {
          "type": "string",
          "description": "来源分支名称",
          "refType": null
        },
        "headCommitId": {
          "type": "string",
          "description": "特性分支创建的初始CommitId",
          "refType": null
        },
        "lastCommitId": {
          "type": "string",
          "description": "特性分支最新的CommitId",
          "refType": null
        }
      }
    }
  }
