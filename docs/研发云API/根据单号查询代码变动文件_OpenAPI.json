  "paths": {
    "/devspace/rpc/v3/task/{taskNo}/change-file": {
      "get": {
        "tags": [
          "事务单管理"
        ],
        "summary": "根据单号查询代码变动文件",
        "description": "查询任务单的代码变更文件列表。传入需求单号返回其下所有任务的变动文件汇总，传入任务/缺陷则返回特性分支上的变动文件",
        "operationId": "qryApiTaskCommitFileDtoListByTaskNo",
        "parameters": [
          {
            "name": "taskNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Operate-User-Code",
            "in": "header",
            "description": "使用系统Token需要添加调用接口的操作人工号，个人Token不需要添加"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMessageListApiTaskBranchChangeFileRespDto"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMessageObject"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMessageObject"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "x-order": {
          "order": "87"
        }
      }
    }
  },
  "components": {
    "ResponseMessageListApiTaskBranchChangeFileRespDto": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ApiTaskBranchChangeFileRespDto"
          }
        },
        "code": {
          "type": "string"
        },
        "msg": {
          "type": "string"
        },
