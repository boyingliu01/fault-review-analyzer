api:
  base_url: "https://zcmtest.iwhalecloud.com:25000"
  timeout: 30
  retry: 3

llm:
  provider: "openai"
  model: "gpt-4"
  temperature: 0.7
  max_tokens: 4096

embedding:
  provider: "openai"
  model: "text-embedding-3-small"

clustering:
  algorithm: "hdbscan"
  min_cluster_size: 5
  min_samples: 3
  metric: "cosine"

cache:
  enabled: true
  ttl: 86400
  storage: "sqlite"

rules:
  builtin_enabled: true
  custom_paths:
    - "./data/rules/custom/"

output:
  format: "markdown"
  directory: "./output/"

logging:
  level: "INFO"
