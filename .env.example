# API Configuration (研发云平台)
API_BASE_URL=https://dev.iwhalecloud.com
DEVCLOUD_TOKEN=your-devcloud-token-here  # 研发云访问令牌
API_TIMEOUT=30
API_RETRY=3

# 研发云缺陷明细页 URL 模板（{urId} 为缺陷单号占位符，Streamlit 明细表链接使用）
RDEV_DETAIL_URL_TEMPLATE=https://dev.iwhalecloud.com/portal/zcm-devspace/spa/task/pc/{urId}

# API Server Configuration
API_HOST=0.0.0.0                            # 监听地址
API_PORT=8000                               # 监听端口
API_VALID_TOKENS=                           # 逗号分隔的合法 Token 列表
API_ALLOW_UNAUTHENTICATED=false             # 仅本地开发可设为 true
API_DOCS_ENABLED=false                      # 默认禁用 /docs /redoc /openapi.json
API_ACCESS_LOG=false                        # 默认禁用 Uvicorn access_log
API_RATE_LIMIT=60                           # 每分钟请求限制
API_CORS_ORIGINS=                           # 允许的跨域来源（逗号分隔，显式配置）
API_CORS_METHODS=GET,POST,OPTIONS           # 允许的跨域方法
API_CORS_HEADERS=Content-Type,X-API-Token   # 允许的跨域请求头

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_BASE_URL=

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=100

# Clustering Configuration
CLUSTERING_ALGORITHM=hdbscan
CLUSTERING_MIN_CLUSTER_SIZE=5
CLUSTERING_MIN_SAMPLES=3
CLUSTERING_METRIC=cosine

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=86400
CACHE_STORAGE=sqlite

# Rules Configuration
RULES_BUILTIN_ENABLED=true
RULES_CUSTOM_PATH=./data/rules/custom/

# Output Configuration
OUTPUT_FORMAT=markdown
OUTPUT_DIRECTORY=./output/

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
