          "代码分支"
        ],
        "summary": "根据代码仓库地址和特性分支名称查询代码分支Commit信息",
        "description": "包括代码分支的开始和结束CommitId",
        "operationId": "qryRpcTaskBranchCommitRespDto",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiFeatureBranchCommitRangeReqDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMessageApiFeatureBranchCommitRangeRespDto"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMessageObject"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMessageObject"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "X-Operate-User-Code",
            "in": "header",
            "description": "使用系统Token需要添加调用接口的操作人工号，个人Token不需要添加"
          }
        ]
      }
    }
  },
  "components": {
    "ApiFeatureBranchCommitRangeReqDto": {
      "type": "object",
      "description": "查询代码分支的提交信息请求体",
      "properties": {
        "repoUrl": {
          "type": "string",
          "description": "仓库地址",
          "refType": null
        },
        "branchName": {
          "type": "string",
          "description": "代码分支名称",
          "refType": null
        }
      },
      "required": [
        "branchName",
        "repoUrl"
      ]
    },
    "ResponseMessageApiFeatureBranchCommitRangeRespDto": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/components/schemas/ApiFeatureBranchCommitRangeRespDto"
        },
        "code": {
          "type": "string"
        },
        "msg": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "finalMessage": {
          "type": "string"
        }
      }
    },
    "ResponseMessageObject": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object"
        },
        "code": {
          "type": "string"
        },
        "msg": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "finalMessage": {
          "type": "string"
        }
      }
    },
    "ApiFeatureBranchCommitRangeRespDto": {
      "type": "object",
      "description": "查询代码分支的提交信息请求返回体",
      "properties": {
        "productModuleId": {
          "type": "integer",
          "format": "int32",
          "description": "应用模块ID",
          "refType": null
